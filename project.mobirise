        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".title-section": {
              "margin-bottom": "4.5rem",
              "padding": "0 90px",
              "@media (max-width: 992px)": {
                "padding": "0 20px",
                "margin-bottom": "2rem"
              }
            },
            ".card, .btn": {
              "box-shadow": "0px 0px 10px 0px rgba(0, 0, 0, 0.1)",
              "transition": "0.2s linear"
            },
            ".card:hover, .btn:hover": {
              "box-shadow": "0px 0px 20px 0px rgba(0, 0, 0, 0.2)"
            },
            ".card": {
              "background-color": "white"
            },
            ".card-img-top": {
              "border-radius": "20px 20px 0 0",
              "width": "100%",
              "height": "auto",
              "& when not (@showTitle) and not (@showButton) and not (@showList)": {
                "border-radius": "20px 20px 20px 20px",
                "margin-bottom": "0"
              }
            },
            ".list": {
              "margin-bottom": "18px"
            },
            ".card-body": {
              "padding-top": "18px",
              "padding-bottom": "20px"
            },
            ".btn": {
              "padding-left": "1rem",
              "padding-right": "1rem"
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#ffffff"
            }
          },
          "_name": "features05",
          "_sourceTheme": "preschoolm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features05\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <header condition=\"cardAmount % 3 != 0\">Row</header>\n        <select condition=\"cardAmount % 3 != 0\" title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n        <input type=\"range\" inline title=\"Amount\" name=\"cardAmount\" min=\"1\" max=\"6\" step=\"1\" value=\"6\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mountains-6761344.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#0e47a1\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper\">\n            <div class=\"row title-section\" mbr-if=\"showMainTitle\">\n                <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" data-app-placeholder=\"Type Text\"><b>Наши преимущества</b></h2>\n            </div>\n            <div class=\"row {{contentAlign}}\">\n                <div class=\"col-12 col-md-4 mb-2 mb-md-5\">\n                    <div class=\"card\">\n                        <img src=\"@PROJECT_PATH@/assets/images/img-20241015-wa0101-719x1280.jpeg\" alt=\"Программы\" class=\"card-img-top\" mbr-if=\"showImage\">\n                        <div class=\"card-body\" mbr-if=\"showTitle || showList || showButton\">\n                            <h3 class=\"card-title mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showTitle\"><b>Программы для разного возраста</b></h3>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\"><b>Младшая</b> <b>группа</b> <b>(2-3 года): </b>акцент на развитие мелкой моторики, речи и базовых навыков самообслуживания.<div><b>Средняя группа (4-5 лет): </b>введение в математику, чтение и творчество, развитие социальных навыков.</div><div><b>Старшая группа (5-7 лет): </b>подготовка к школе, развитие логического мышления, обучение основам наук.</div></ul>\n                            <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnRemove,-mbrBtnAdd\" mbr-if=\"showButton\"><a class=\"justify-content-center btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                    ENROLL NOW</a></div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-4 mb-2 mb-md-5\" mbr-if=\"cardAmount > 1\">\n                    <div class=\"card\">\n                        <img src=\"@PROJECT_PATH@/assets/images/2022-08-24-01.09.01-1-782x524.png\" alt=\"Mobirise\" class=\"card-img-top\" mbr-if=\"showImage\">\n                        <div class=\"card-body\" mbr-if=\"showTitle || showList || showButton\">\n                            <h3 class=\"card-title mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showTitle\"><b>Английский язык</b></h3>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">Изучение английского языка<div>в игровой форме для детей от 2 до 4 лет и&nbsp;<span style=\"font-size: 1rem;\">практический курс для детей 5-7 лет.</span></div><div><b>- </b>Развитие интереса к английскому языку;</div><div><span style=\"font-size: 1rem;\"><b>-</b> Формирование базового словарного запаса и грамматики;<br></span><span style=\"font-size: 1rem;\"><b>-</b> Развитие умений восприятия английской речи на слух;<br></span><span style=\"font-size: 1rem;\"><b>-</b> Формирование навыков письма и чтения.</span></div></ul>\n                            <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnRemove,-mbrBtnAdd\" mbr-if=\"showButton\"><a class=\"justify-content-center btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                    ENROLL NOW</a></div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-4 mb-2 mb-md-5\" mbr-if=\"cardAmount > 2\">\n                    <div class=\"card\">\n                        <img src=\"@PROJECT_PATH@/assets/images/-2024-10-28-21.09.51-786x790.png\" alt=\"Видеонаблюдение детского сада\" class=\"card-img-top\" mbr-if=\"showImage\">\n                        <div class=\"card-body\" mbr-if=\"showTitle || showList || showButton\">\n                            <h3 class=\"card-title mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showTitle\"><b>Видеонаблюдение</b></h3>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">Все наши сады оснащены системами видеонаблюдения для обеспечения безопасности детей и контроля за территорией.</ul>\n                            <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnRemove,-mbrBtnAdd\" mbr-if=\"showButton\"><a class=\"justify-content-center btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                    ENROLL NOW</a></div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-4 mb-2 mb-md-5\" mbr-if=\"cardAmount > 3\">\n                    <div class=\"card\">\n                        <img src=\"@PROJECT_PATH@/assets/images/20220725-113334-786x590.jpg\" alt=\"Безопасность\" class=\"card-img-top\" mbr-if=\"showImage\">\n                        <div class=\"card-body\" mbr-if=\"showTitle || showList || showButton\">\n                            <h3 class=\"card-title mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showTitle\"><b>Безопасность</b></h3>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">Безопасная среда – основа детского пространства: специальная мебель без острых углов из экологичных материалов, сертифицированные игрушки, гипоаллергенные моющие средства. Регулярное кварцевание в соответствии с СанПиН.</ul>\n                            <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnRemove,-mbrBtnAdd\" mbr-if=\"showButton\">\n                                <a class=\"justify-content-center btn btn-white\" data-app-placeholder=\"Type Text\">\n                                    REGISTER TODAY\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-4 mb-2 mb-md-5\" mbr-if=\"cardAmount > 4\">\n                    <div class=\"card\">\n                        <img src=\"@PROJECT_PATH@/assets/images/2022-08-24-01.32.15-1-782x519.png\" alt=\"Mobirise\" class=\"card-img-top\" mbr-if=\"showImage\">\n                        <div class=\"card-body\" mbr-if=\"showTitle || showList || showButton\">\n                            <h3 class=\"card-title mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showTitle\"><b>Питание</b></h3>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">Сбалансированное пятиразовое питание, здоровое и вкусное меню, с учетом особенностей диеты Вашего ребенка, контроль качества.</ul>\n                            <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnRemove,-mbrBtnAdd\" mbr-if=\"showButton\">\n                                <a class=\"justify-content-center btn btn-white\" data-app-placeholder=\"Type Text\">\n                                    REGISTER TODAY\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-4 mb-2 mb-md-5\" mbr-if=\"cardAmount > 5\">\n                    <div class=\"card\">\n                        <img src=\"@PROJECT_PATH@/assets/images/img-20241016-wa0005-786x590.jpeg\" alt=\"Зарядка в детском саду\" class=\"card-img-top\" mbr-if=\"showImage\">\n                        <div class=\"card-body\" mbr-if=\"showTitle || showList || showButton\">\n                            <h3 class=\"card-title mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showTitle\"><b>Здоровье</b></h3>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">Регулярное проветривание и рециркуляция воздуха обеспечивают здоровую атмосферу в помещении, предотвращая накопление углекислого газа и улучшая качество воздуха. Активные игры и физкультминутки стимулируют кровообращение, повышают уровень энергии и способствуют общему физическому развитию детей.</ul>\n                            <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnRemove,-mbrBtnAdd\" mbr-if=\"showButton\">\n                                <a class=\"justify-content-center btn btn-white\" data-app-placeholder=\"Type Text\">\n                                    REGISTER TODAY\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sRQcud4Jjb",
          "_anchor": "features05-2",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".card-1": {
              "background-color": "@cardColor1"
            },
            ".card-2": {
              "background-color": "@cardColor2"
            },
            "@media (min-width: 992px)": {
              ".first-cont": {
                "margin-top": "-1rem"
              },
              ".sec-cont": {
                "margin-bottom": "-1.5rem"
              }
            },
            ".mbr-section-btn": {
              "position": "relative"
            },
            ".card-body": {
              "padding": "4rem 2rem 5rem 5rem",
              "@media (max-width: 992px)": {
                "padding": "50px 20px"
              }
            },
            ".card-img": {
              "width": "100%",
              "height": "250px",
              "@media (max-width: 992px)": {
                "height": "300px"
              }
            },
            ".card-img-container": {
              "height": "300px",
              "width": "250px",
              "position": "relative"
            },
            ".img": {
              "width": "100%",
              "height": "100%",
              "object-fit": "cover",
              "position": "absolute"
            },
            ".decor": {
              "width": "90px",
              "height": "90px",
              "position": "absolute",
              "& svg": {
                "width": "100%",
                "height": "100%"
              }
            },
            ".decor.first": {
              "bottom": "0",
              "right": "0",
              "& svg": {
                "fill": "@decorColor1"
              }
            },
            ".decor.second": {
              "top": "10%",
              "left": "0",
              "& svg": {
                "fill": "@decorColor2"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "features02",
          "_sourceTheme": "preschoolm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features02\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Decoration 1\" name=\"showDec1\" condition=\"showImage\" checked>\n        <input type=\"checkbox\" title=\"Decoration 2\" name=\"showDec2\" condition=\"cardAmount > 1 &amp;&amp; showImage\" checked=\"checked\">\n        <header>Row</header>\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header condition=\"showImage\">Image</header>\n        <select title=\"Align\" name=\"imageAlign\" condition=\"showImage\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\" selected>Right</option>\n        </select>\n        <header>Card</header>\n        <input type=\"range\" inline title=\"Amount\" name=\"cardAmount\" min=\"1\" max=\"2\" step=\"1\" value=\"2\">\n        <input type=\"color\" title=\"Color 1\" name=\"cardColor1\" value=\"#f5e74c\">\n        <input type=\"color\" title=\"Color 2\" name=\"cardColor2\" value=\"#dba5f7\" condition=\"cardAmount > 1\">\n        <header condition=\"showImage\">Decoration</header>\n        <input type=\"color\" title=\"Color 1\" name=\"decorColor1\" value=\"#bc5dec\" condition=\"showImage && showDec1\">\n        <input type=\"color\" title=\"Color 2\" name=\"decorColor2\" value=\"#f5e74c\" condition=\"showImage &amp;&amp; cardAmount > 1 &amp;&amp; showDec2\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/bg/3-bg.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/bg/1-bg.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper p-0\">\n            <div class=\"row {{contentAlign}}\">\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"card card-1\">\n                        <div class=\"card-body\">\n                            <h3 class=\"card-title mbr-section-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showTitle\"><b>Программы для детей 2-4 года</b></h3>\n                            <div class=\"card-img {{imageAlign}} align-items-center\" mbr-class=\"{'d-flex': showImage}\" mbr-if=\"showImage\">\n                                <div class=\"card-img-container first-cont\">\n                                    <img src=\"../_images/people/6-people.jpg\" alt=\"Mobirise\" style=\"clip-path: url(#mask1);\" class=\"img\">\n                                    <div class=\"decor first\" mbr-if=\"showDec1\">\n                                        <svg viewBox=\"0 0 1 1\">\n                                            <path stroke-width=\"0.09\" d=\"M 0.061 0.168 C 0.16 0.133 0.252 0.096 0.389 0.07 C 0.507 0.051 0.524 0.08 0.483 0.143 C 0.419 0.255 0.25 0.384 0.163 0.496 C 0.087 0.594 0.131 0.622 0.227 0.57 C 0.364 0.4813 0.582 0.3307 0.8 0.18 C 0.884 0.116 0.937 0.154 0.888 0.249 C 0.764 0.478 0.602 0.697 0.436 0.907 C 0.393 0.963 0.332 0.931 0.381 0.87 C 0.519 0.703 0.638 0.528 0.761 0.35 C 0.816 0.273 0.801 0.256 0.719 0.32 C 0.534 0.458 0.343 0.601 0.211 0.668 C 0.048 0.749 -0.042 0.627 0.068 0.496 C 0.128 0.435 0.227 0.307 0.35 0.196 C 0.4 0.155 0.385 0.125 0.317 0.149 C 0.2323 0.1747 0.1507 0.2033 0.081 0.22 C 0.034 0.238 0.011 0.185 0.061 0.168\">\n                                            </path>\n                                        </svg>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnRemove,-mbrBtnAdd\" mbr-if=\"showButtons\"><a class=\"btn btn-white\" data-app-placeholder=\"Введите Текст\" href=\"popup:#mbr-popup-h\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-h\" data-bs-target=\"#mbr-popup-h\">\n                                    ЗАПИСАТЬСЯ</a></div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\" mbr-if=\"cardAmount > 1\">\n                    <div class=\"card card-2\">\n                        <div class=\"card-body\">\n                            <h3 class=\"card-title mbr-section-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showTitle\"><b>Дошкольная программа 5-7 лет</b></h3>\n                            <div class=\"card-img {{imageAlign}} align-items-center\" mbr-class=\"{'d-flex': showImage}\" mbr-if=\"showImage\">\n                                <div class=\"card-img-container sec-cont\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/img-20241016-wa0011-500x890.jpg\" alt=\"Подготовка к школе в детском саду Капитошка\" style=\"clip-path: url(#mask2);\" class=\"img\">\n                                    <div class=\"decor second\" mbr-if=\"showDec2\">\n                                        <svg viewBox=\"0 0 1 1\">\n                                            <path stroke-width=\"0.09\" d=\"M 0.051 0.208 C 0.33 0.134 0.455 0.114 0.748 0.1 C 0.829 0.099 0.849 0.132 0.803 0.179 C 0.582 0.376 0.3387 0.5123 0.133 0.664 C 0.052 0.727 0.087 0.74 0.161 0.709 C 0.385 0.621 0.539 0.56 0.828 0.496 C 0.971 0.465 1.009 0.541 0.874 0.64 C 0.718 0.748 0.586 0.832 0.422 0.927 C 0.38 0.949 0.348 0.902 0.394 0.873 C 0.522 0.799 0.637 0.727 0.819 0.608 C 0.904 0.55 0.894 0.541 0.816 0.562 C 0.563 0.613 0.369 0.712 0.143 0.783 C 0.021 0.818 -0.027 0.722 0.066 0.643 C 0.256 0.498 0.503 0.351 0.734 0.175 C 0.755 0.159 0.753 0.153 0.722 0.156 C 0.486 0.179 0.264 0.223 0.051 0.273 C 0.01 0.28 -0.008 0.226 0.051 0.208\">\n                                            </path>\n                                        </svg>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnRemove,-mbrBtnAdd\" mbr-if=\"showButtons\"><a class=\"btn btn-white\" data-app-placeholder=\"Введите Текст\" href=\"popup:#mbr-popup-i\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-i\" data-bs-target=\"#mbr-popup-i\">ЗАПИСАТЬСЯ</a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <svg width=\"0\" height=\"0\" mbr-if=\"showImage\">\n        <defs>\n            <clipPath id=\"mask1\" clipPathUnits=\"objectBoundingBox\">\n                <path id=\"curve\" d=\"M 0.251 0.06 C 0.676 0.236 0.847 0.061 0.948 0.359 C 1.017 0.558 0.94 0.814 0.472 0.92 C 0.178 0.984 0.118 0.859 0.063 0.691 C -0.007 0.432 0.036 0.002 0.251 0.06\">\n                </path>\n            </clipPath>\n            <clipPath id=\"mask2\" clipPathUnits=\"objectBoundingBox\">\n                <path id=\"curve\" d=\"M 0.088 0.65 C 0.285 0.835 0.381 1.077 0.686 0.965 C 1.096 0.781 1.065 -0.097 0.627 0.089 C 0.298 0.248 0.195 0.226 0.083 0.31 C 0.005 0.368 -0.009 0.558 0.088 0.65\">\n                </path>\n            </clipPath>\n        </defs>\n    </svg>\n\n</section>",
          "_cid": "uswBSkiWoT",
          "_anchor": "features02-0",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".title-section": {
              "padding": "0px",
              "margin-bottom": "20px"
            },
            "@media (min-width: 992px)": {
              ".title-section": {
                "padding": "0 90px",
                "margin-bottom": "40px"
              }
            },
            ".btn": {
              "display": "flex"
            },
            ".card": {
              "background-color": "if(@isTransparent, transparent, @cardColor)",
              "& when (@hasShadow)": {
                "box-shadow": "0px 10px 20px 0px rgba(29, 29, 27, 0.2)"
              }
            },
            ".card-body": {
              "padding": "40px 55px 30px 55px"
            },
            ".col-img": {
              "width": "35px",
              "height": "35px",
              "flex": "0 0 35px",
              "margin-right": "22px"
            },
            ".card-title": {
              "flex": "1 1 auto",
              "width": "auto"
            },
            ".price": {
              "text-align": "left"
            },
            ".title-section .mbr-section-subtitle": {
              "text-align": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".text1": {
              "text-align": "left"
            },
            ".title-section .mbr-section-title": {
              "color": "#1164e5"
            }
          },
          "_name": "pricing02",
          "_sourceTheme": "preschoolm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing02\" group=\"Pricing\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <header condition=\"cardAmount != 3\">Row</header>\n        <select condition=\"cardAmount != 3\" title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Card</header>\n        <input type=\"range\" inline title=\"Amount\" name=\"cardAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Price\" name=\"showPrice\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\" checked>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"isTransparent\" checked>\n        <input type=\"color\" title=\"Color\" name=\"cardColor\" value=\"#ffffff\" condition=\"!isTransparent\">\n        <input type=\"checkbox\" title=\"Shadow\" name=\"hasShadow\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/bg/1-bg.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/bg/1-bg.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper\">\n            <div class=\"row title-section\" mbr-if=\"showTitle || showSubtitle\">\n                <h2 class=\"mbr-section-title mbr-fonts-style col-12 col-md-6 mb-4\" mbr-theme-style=\"display-2\" data-app-selector=\".title-section .mbr-section-title\" data-app-placeholder=\"Type Text\" mbr-if=\"showTitle\">\n                    <b>Посещение</b></h2>\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style col-12 col-md-6\" mbr-theme-style=\"display-7\" data-app-selector=\".title-section .mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showSubtitle\"><b>Для каждого ребенка предусмотрена система мягкой адаптации: совместно с Вами мы подберем удобный для Вас адаптационный график.</b></h3>\n            </div>\n            <div class=\"row {{contentAlign}}\">\n                <div class=\"col-12 col-lg-4\">\n                    <div class=\"card\">\n                        <div class=\"card-body\">\n                            <div class=\"mb-3 d-flex align-items-center\">\n                                <img src=\"../_images/vector/stars/green.svg\" alt=\"Mobirise\" class=\"col-img\" mbr-if=\"showIcon\">\n                                <h4 class=\"card-title mbr-section-subtitle mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showCardTitle\"><b>Полный день</b></h4>\n                            </div>\n                            <p class=\"mbr-text text1 mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" data-app-selector=\".text1\" data-app-placeholder=\"Type Text\" mbr-if=\"showText\">\n                                - пятиразовое питание<br>- развивающие занятия (до и после обеда)<br>- английский язык <br> - активные игры<br>- присмотр и уход&nbsp;&nbsp;<br> \n                            </p>\n                            <p class=\"mbr-text price mbr-fonts-style mb-4\" mbr-theme-style=\"display-5\" data-app-selector=\".price\" data-app-placeholder=\"Type Text\" mbr-if=\"showPrice\"><b>26 000 руб. в месяц</b></p>\n                            <div class=\"mbr-section-btn mb-3\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" mbr-if=\"showButton\"><a class=\"btn btn-primary justify-content-center\" data-app-placeholder=\"Введите Текст\" href=\"popup:#mbr-popup-j\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-j\" data-bs-target=\"#mbr-popup-j\">\n                                    ВЫБРАТЬ</a></div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-lg-4\" mbr-if=\"cardAmount > 1\">\n                    <div class=\"card\">\n                        <div class=\"card-body\">\n                            <div class=\"mb-3 d-flex align-items-center\">\n                                <img src=\"../_images/vector/stars/cyan.svg\" alt=\"Mobirise\" class=\"col-img\" mbr-if=\"showIcon\">\n                                <h4 class=\"card-title mbr-section-subtitle mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showCardTitle\"><b>Короткий день</b></h4>\n                            </div>\n                            <p class=\"mbr-text text1 mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" data-app-selector=\".text1\" data-app-placeholder=\"Type Text\" mbr-if=\"showText\">\n                                - трехразовое питание<br>- развивающие занятия (до обеда)<br>- английский язык<br>- активные игры<br>- присмотр и уход<br><br>\n                            </p>\n                            <p class=\"mbr-text price mbr-fonts-style mb-4\" mbr-theme-style=\"display-5\" data-app-selector=\".price\" data-app-placeholder=\"Type Text\" mbr-if=\"showPrice\"><b>19 800 руб. в месяц</b></p>\n                            <div class=\"mbr-section-btn mb-3\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" mbr-if=\"showButton\"><a class=\"btn btn-primary justify-content-center\" data-app-placeholder=\"Введите Текст\" href=\"popup:#mbr-popup-j\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-j\" data-bs-target=\"#mbr-popup-j\">\n                                    ВЫБРАТЬ</a></div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-lg-4\" mbr-if=\"cardAmount > 2\">\n                    <div class=\"card\">\n                        <div class=\"card-body\">\n                            <div class=\"mb-3 d-flex align-items-center\">\n                                <img src=\"../_images/vector/stars/purple.svg\" alt=\"Mobirise\" class=\"col-img\" mbr-if=\"showIcon\">\n                                <h4 class=\"card-title mbr-section-subtitle mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showCardTitle\"><b>Дополнительно</b></h4>\n                            </div>\n                            <p class=\"mbr-text text1 mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" data-app-selector=\".text1\" data-app-placeholder=\"Type Text\" mbr-if=\"showText\">- полный день – <b>1500 руб</b>.<br>- короткий день – <b>1000 руб.</b><br>- «Школа раннего развития» – <b>350 руб./занятие</b><br>- группа «Подготовка к школе» - <b>500</b> <b>руб./занятие</b><b><br></b><b>-&nbsp;</b>почасовое пребывание- <b>350 руб./час</b><br></p>\n                            <!--p class=\"mbr-text price mbr-fonts-style mb-4\" mbr-theme-style=\"display-5\" data-app-selector=\".price\" data-app-placeholder=\"Type Text\" mbr-if=\"showPrice\"><b>от 350 руб.</b></p-->\n                            <div class=\"mbr-section-btn mb-3\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" mbr-if=\"showButton\"><a class=\"btn btn-primary justify-content-center\" data-app-placeholder=\"Введите Текст\" href=\"popup:#mbr-popup-j\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-j\" data-bs-target=\"#mbr-popup-j\">УЗНАТЬ ПОДРОБНЕЙ</a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uswIk16iex",
          "_anchor": "pricing02-3",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
