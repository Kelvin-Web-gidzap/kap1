        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@showDecor)": {
              ".decor": {
                "width": "90px",
                "height": "90px",
                "position": "relative",
                "flex": "0 0 100px",
                "& svg": {
                  "width": "100%",
                  "height": "100%",
                  "position": "absolute",
                  "fill": "@decorColor",
                  "transform": "rotate(210deg) scale(1, -1)"
                }
              }
            },
            ".mbr-text": {
              "color": "#1d1d1b"
            },
            ".mbr-section-title": {
              "color": "#1164e5"
            },
            ".mbr-section-subtitle": {
              "color": "#ad39e7"
            }
          },
          "_name": "header01",
          "_sourceTheme": "preschoolm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header01\" group=\"Header\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\" checked>\n        <input type=\"checkbox\" title=\"Decoration\" name=\"showDecor\" checked condition=\"showButton\">\n        <header condition=\"showDecor && showButton\">Decoration</header>\n        <input type=\"color\" title=\"Color\" name=\"decorColor\" value=\"#3ab0da\" condition=\"showDecor && showButton\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/3-bg.jpg\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ebeae2\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper p-3 py-5 p-lg-5\">\n            <div class=\"row justify-content-center justify-content-lg-start\">\n                <div class=\"col-12 col-md-6\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style pb-3\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" data-app-placeholder=\"Type Text\" mbr-if=\"showTitle\"><b>ДЕТСКИЙ САД</b></h1>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-if=\"showText\">\n                        Morbi gravida lectus in vehicula placerat.\n                        Phasellus eget magna leo. Orci varius natoque penatibus et magnis dis parturient montes,\n                        nascetur ridiculus mus. Morbi a euismod velit. Ut in justo sed ipsum rutrum ornare. Praesent\n                        semper arcu ut massa eleifend sodales. Integer vestibulum sapien et malesuada convallis.\n                    </p>\n                </div>\n            </div>\n            <div class=\"row justify-content-center justify-content-lg-start mt-4\">\n                <div class=\"col-12 col-md-6\">\n                    <h2 class=\"mbr-section-subtitle mbr-fonts-style pb-3\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showSubtitle\">С изучением английского языка</h2>\n                </div>\n                <div class=\"col-12 col-md-6 d-flex\">\n                    <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrBtnRemove,-mbrBtnAdd\" mbr-if=\"showButton\"><a class=\"btn btn-primary\" data-app-placeholder=\"Введите Текст\" href=\"index.html#features01-1\">ПОДРОБНЕЙ</a></div>\n                    <div class=\"decor\" mbr-if=\"showDecor && showButton\">\n                        <svg viewBox=\"0 0 1 1\">\n                            <path stroke-width=\"0.09\" d=\"M 0.192 0.241 C 0.212 0.213 0.245 0.236 0.224 0.266 C 0.027 0.571 0.314 0.802 0.603 0.551 C 0.854 0.324 0.491 0.05 0.391 0.362 C 0.285 0.683 0.524 0.787 0.807 0.789 L 0.71 0.654 C 0.697 0.628 0.729 0.607 0.748 0.631 L 0.867 0.793 C 0.885 0.813 0.889 0.825 0.868 0.845 L 0.723 0.986 C 0.699 1.001 0.675 0.973 0.699 0.948 L 0.804 0.834 C 0.187 0.821 0.326 0.417 0.364 0.317 C 0.56 -0.027 0.875 0.353 0.637 0.571 C 0.388 0.836 -0.072 0.66 0.192 0.241\">\n                            </path>\n                        </svg>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sRQby9NjFs",
          "_anchor": "header01-0",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".wrapper": {
              "background-color": "@rowColor",
              "padding": "100px 90px 50px 90px",
              "@media (max-width: 992px)": {
                "padding": "20px 30px"
              }
            },
            ".title-section": {
              "margin-bottom": "50px"
            },
            ".card-1": {
              "background-color": "@card1BG"
            },
            ".card-2": {
              "background-color": "@card2BG"
            },
            ".card-3": {
              "background-color": "@card3BG"
            },
            ".card-4": {
              "background-color": "@card4BG"
            },
            ".card-img-top": {
              "width": "35px",
              "height": "35px"
            },
            ".main-sect.mbr-section-title": {
              "color": "#1164e5"
            }
          },
          "_name": "features01",
          "_sourceTheme": "preschoolm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features01\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Row</header>\n        <select condition=\"cardAmount < 4\" title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <input type=\"color\" title=\"Color\" name=\"rowColor\" value=\"#ffffff\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"cardAmount\" min=\"1\" max=\"4\" step=\"1\" value=\"4\">\n        <header condition=\"showImage\">Image</header>\n        <select title=\"Align\" name=\"imageAlign\" condition=\"showImage\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Color</header>\n        <input type=\"color\" title=\"Color 1\" name=\"card1BG\" value=\"#ffa4a7\">\n        <input type=\"color\" title=\"Color 2\" name=\"card2BG\" value=\"#90c8ff\" condition=\"cardAmount > 1\">\n        <input type=\"color\" title=\"Color 3\" name=\"card3BG\" value=\"#ffbb7a\" condition=\"cardAmount > 2\">\n        <input type=\"color\" title=\"Color 4\" name=\"card4BG\" value=\"#95ff81\" condition=\"cardAmount > 3\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mountains-6761344.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#0e47a1\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper\">\n            <div class=\"row justify-content-between title-section\" mbr-if=\"showTitle || showText\">\n                <div class=\"col-12 col-md-5\">\n                    <h1 class=\"main-sect mbr-section-title mbr-fonts-style mb-3 mb-lg-0\" mbr-theme-style=\"display-2\" data-app-selector=\".main-sect.mbr-section-title\" data-app-placeholder=\"Type Text\" mbr-if=\"showTitle\"><b>Главные цели</b></h1>\n                </div>\n                <div class=\"col-12 col-md-5\">\n                    <p class=\"main-sect mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".main-sect.mbr-text\" data-app-placeholder=\"Type Text\" mbr-if=\"showText\">Наш детский сад осуществляет присмотр и уход за детьми от 1 г. 8 мес. до 7 лет, учитывая индивидуальные особенности каждого ребёнка. Мы заботимся о Ваших детках, их безопасности и всестороннем развитии.</p>\n                </div>\n            </div>\n            <div class=\"row {{contentAlign}}\">\n                <div class=\"col-12 col-md-5 col-lg-3\" mbr-if=\"cardAmount > 0\">\n                    <div class=\"card card-1\">\n                        <div class=\"card-body\">\n                            <div class=\"mb-3 {{imageAlign}}\" mbr-class=\"{'d-flex': showImage}\" mbr-if=\"showImage\">\n                                <img src=\"@THEME_PATH@/components/_images/vector/icons/4-icons.svg\" alt=\"Mobirise\" class=\"card-img-top\">\n                            </div>\n                            <h3 class=\"mbr-section-subtitle mbr-fonts-style mb-2\" mbr-theme-style=\"display-5\" data-app-selector=\".card .mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showCardTitle\"><b>Интеллект</b></h3>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card .mbr-text\" data-app-placeholder=\"Type Text\" mbr-if=\"showCardText\">Развивающие занятия с профессиональными педагогами. Развитие логики, мышления, памяти и внимания через игры и задания.</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-5 col-lg-3\" mbr-if=\"cardAmount > 1\">\n                    <div class=\"card card-2\">\n                        <div class=\"card-body\">\n                            <div class=\"mb-3 {{imageAlign}}\" mbr-class=\"{'d-flex': showImage}\" mbr-if=\"showImage\">\n                                <img src=\"@THEME_PATH@/components/_images/vector/icons/11-icons.svg\" alt=\"Mobirise\" class=\"card-img-top\">\n                            </div>\n                            <h3 class=\"mbr-section-subtitle mbr-fonts-style mb-2\" mbr-theme-style=\"display-5\" data-app-selector=\".card .mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showCardTitle\"><b>Личность</b></h3>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card .mbr-text\" data-app-placeholder=\"Type Text\" mbr-if=\"showCardText\">Развитие социальных навыков, эмоционального интеллекта, самооценки и лидерских качеств через ролевые игры и взаимодействие.</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-5 col-lg-3\" mbr-if=\"cardAmount > 2\">\n                    <div class=\"card card-3\">\n                        <div class=\"card-body\">\n                            <div class=\"mb-3 {{imageAlign}}\" mbr-class=\"{'d-flex': showImage}\" mbr-if=\"showImage\">\n                                <img src=\"@THEME_PATH@/components/_images/vector/icons/3-icons.svg\" alt=\"Mobirise\" class=\"card-img-top\">\n                            </div>\n                            <h3 class=\"mbr-section-subtitle mbr-fonts-style mb-2\" mbr-theme-style=\"display-5\" data-app-selector=\".card .mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showCardTitle\"><b>Творчество</b></h3>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card .mbr-text\" data-app-placeholder=\"Type Text\" mbr-if=\"showCardText\">\n                                Развитие фантазии, воображения, креативности, нестандартного мышления.</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-5 col-lg-3\" mbr-if=\"cardAmount > 3\">\n                    <div class=\"card card-4\">\n                        <div class=\"card-body\">\n                            <div class=\"mb-3 {{imageAlign}}\" mbr-class=\"{'d-flex': showImage}\" mbr-if=\"showImage\">\n                                <img src=\"@THEME_PATH@/components/_images/vector/icons/10-icons.svg\" alt=\"Mobirise\" class=\"card-img-top\">\n                            </div>\n                            <h3 class=\"mbr-section-subtitle mbr-fonts-style mb-2\" mbr-theme-style=\"display-5\" data-app-selector=\".card .mbr-section-subtitle\" data-app-placeholder=\"Type Text\" mbr-if=\"showCardTitle\"><b>Социализация</b></h3>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card .mbr-text\" data-app-placeholder=\"Type Text\" mbr-if=\"showCardText\">\n                                Выстраивание отношений с другими людьми и формирование навыков командной работы.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sRQbBIAVHg",
          "_anchor": "features01-1",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".card": {
              "background": "transparent"
            },
            ".card-img": {
              "width": "32px",
              "height": "32px",
              "object-fit": "contain"
            },
            ".col.img": {
              "flex": "0 0 32px"
            },
            ".col.text": {
              "flex": "1 1 75%"
            },
            ".card-body": {
              "padding": "10px"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-title": {
              "color": "#ad39e7"
            }
          },
          "_name": "features11",
          "_sourceTheme": "preschoolm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features11\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showImage\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Row</header>\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Column</header>\n        <input type=\"range\" inline title=\"Amount\" name=\"colAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"3\">\n        <header condition=\"showText\">Text</header>\n        <input type=\"range\" inline title=\"Width\" name=\"textWidth\" min=\"1\" max=\"5\" step=\"0.2\" value=\"5\" condition=\"showText\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/bg/2-bg.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/bg/1-bg.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper p-3 py-5 p-lg-5\">\n            <div class=\"row mb-4\" mbr-if=\"showTitle\">\n                <div class=\"col-12\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" data-app-placeholder=\"Type Text\">Разные варианты посещений</h2>\n                </div>\n            </div>\n            <div class=\"row {{contentAlign}}\">\n                <div class=\"card col-12 col-lg-4\">\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col img pt-1\" mbr-if=\"showImage\">\n                                <img class=\"card-img\" src=\"../_images/vector/stars/purple.svg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"col text\" mbr-if=\"showText\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-style=\"{'width': 'calc(' + textWidth + '* 20%)'}\"><b><a href=\"index.html#pricing02-3\" class=\"text-black\">Полный день (8:00 - 19:00)</a></b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12 col-lg-4\" mbr-if=\"colAmount > 1\">\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col img pt-1\" mbr-if=\"showImage\">\n                                <img class=\"card-img\" src=\"../_images/vector/stars/red.svg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"col text\" mbr-if=\"showText\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-style=\"{'width': 'calc(' + textWidth + '* 20%)'}\"><b><a href=\"index.html#pricing02-3\" class=\"text-black\">Короткий день (8:00 - 12:45)</a></b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12 col-lg-4\" mbr-if=\"colAmount > 2\">\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col img pt-1\" mbr-if=\"showImage\">\n                                <img class=\"card-img\" src=\"../_images/vector/stars/orange.svg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"col text\" mbr-if=\"showText\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-style=\"{'width': 'calc(' + textWidth + '* 20%)'}\"><b><a href=\"index.html#pricing02-3\" class=\"text-black\">Пребывание от 1 часа</a></b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
