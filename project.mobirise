        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".wrapper": {
              "background-color": "if(@isTransparent, transparent, @rowColor)",
              "& when (@hasShadow)": {
                "box-shadow": "0px 10px 20px 0px rgba(29, 29, 27, 0.2)"
              }
            },
            ".container": {
              "@media (min-width: 992px)": {
                "padding": "60px"
              }
            },
            ".carousel": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center",
              "& .carousel-container": {
                "position": "relative",
                "& .carousel-inner": {
                  "border-radius": "20px"
                },
                "& .carousel-indicators": {
                  "position": "absolute",
                  "bottom": "0px",
                  "left": "50%",
                  "transform": "translateX(-50%)",
                  "padding": "20px 0",
                  "margin": "0",
                  "display": "flex",
                  "& button": {
                    "display": "block",
                    "width": "10px",
                    "height": "10px",
                    "flex": "0 0 10px",
                    "margin": "0 8px",
                    "padding": "0",
                    "border-radius": "50%",
                    "background-color": "lighten(@indicatorsColor, 40%)",
                    "opacity": "1",
                    "transition": "0.4s ease"
                  },
                  "& .active": {
                    "background-clip": "padding-box",
                    "background-color": "@indicatorsColor"
                  }
                }
              },
              "& .buttons-container": {
                "width": "80px",
                "display": "flex",
                "justify-content": "space-between",
                "& button": {
                  "display": "flex",
                  "justify-content": "center",
                  "align-items": "center",
                  "background-color": "@controlsColor",
                  "border-radius": "50%",
                  "width": "32px",
                  "height": "32px",
                  "& span": {
                    "line-height": "2px",
                    "color": "white"
                  }
                }
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "H2": {
              "color": "#1164e5"
            }
          },
          "_name": "form02",
          "_sourceTheme": "preschoolm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form02\" group=\"Form\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Row</header>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"isTransparent\" checked>\n        <input type=\"color\" title=\"Color\" name=\"rowColor\" value=\"#cc81f2\" condition=\"!isTransparent\">\n        <input type=\"checkbox\" title=\"Shadow\" name=\"hasShadow\" checked>\n        <header>Slides</header>\n        <select title=\"Animation\" name=\"animationType\">\n            <option value selected>Slide</option>\n            <option value=\"carousel-fade\">Fade</option>\n        </select>\n        <input type=\"checkbox\" title=\"Indicators\" name=\"showIndicators\" checked>\n        <input type=\"checkbox\" title=\"Controls\" name=\"showControls\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"slidesAmount\" min=\"2\" max=\"8\" step=\"1\" value=\"8\">\n        <input type=\"range\" inline title=\"Interval\" name=\"slidesInterval\" min=\"1\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"color\" title=\"Indicators\" name=\"controlsColor\" value=\"#ff0066\" condition=\"showControls\">\n        <input type=\"color\" title=\"Indicators\" name=\"indicatorsColor\" value=\"#ff0066\" condition=\"showIndicators\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/bg/5-bg.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/bg/1-bg.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper p-3 py-5 p-lg-5\">\n            <div class=\"row\">\n                <div class=\"col-12 col-lg-6 p-5\">\n                    <div mbr-form class=\"mbr-form\">\n<!--Formbuilder Form-->\n<form action=\"kapitoshka.adler@bk.ru\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"kapitoshka.adler@bk.ru\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Спасибо за интерес к нашему развивающему центру для тетей. В ближайшее время мы вам позвоним и договоримся о времени.</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some problem! </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-12\">\n<h2 mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" class=\"mbr-section-title mbr-fonts-style\">Приглашаем в наш детский сад</h2>\n</div>\n<div class=\"col-12\">\n<p mbr-theme-style=\"display-7\" mbr-if=\"showText\" class=\"mbr-text mbr-fonts-style\"> <br>Площадь детского сада- 300кв.м, наличие собственного пищеблока,зала для спортивных  и музыкальных занятий.<br><br> </p>\n</div>\n<div data-for=\"Имя\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<input type=\"text\" name=\"Имя\" placeholder=\"Имя\" data-form-field=\"Имя\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n</div>\n<div data-for=\"Телефон\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<input type=\"text\" name=\"Телефон\" placeholder=\"Телефон\" data-form-field=\"Телефон\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"w-100 w-100 btn btn-primary justify-content-center\" data-app-placeholder=\"Введите Текст\">ЗАПИСАТЬСЯ</a></div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n                </div>\n                <div class=\"col-12 col-lg-6 d-flex pt-lg-5 pe-lg-5\">\n                    <div id=\"carouselIndicatorsF02\" class=\"carousel slide {{animationType}}\" data-bs-ride=\"carousel\" data-bs-interval=\"{{slidesInterval*1000}}\">\n                        <div class=\"carousel-container\">\n                            <div class=\"carousel-inner\">\n                                <div class=\"carousel-item active\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/img-20241007-wa0154-1-1008x756.jpg\" class=\"d-block w-100\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/20220725-113913-1-1008x756.jpg\" class=\"d-block w-100\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/20220725-113702-1008x756.jpg\" class=\"d-block w-100\" alt=\"Mobirise\" mbr-if=\"slidesAmount > 2\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/20220725-113830-1008x756.jpg\" class=\"d-block w-100\" alt=\"Mobirise\" mbr-if=\"slidesAmount > 3\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/20220725-113334-1008x756.jpg\" class=\"d-block w-100\" alt=\"Детский сад Капитошка\" mbr-if=\"slidesAmount > 4\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/20220725-113119-1008x756.jpg\" class=\"d-block w-100\" alt=\"Капитошка\" mbr-if=\"slidesAmount > 5\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/20220725-113058-1008x756.jpg\" class=\"d-block w-100\" alt=\"Кухня капитошка\" mbr-if=\"slidesAmount > 6\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/20220725-113913-1-1008x756.jpg\" class=\"d-block w-100\" alt=\"Капитошка вход\" mbr-if=\"slidesAmount > 7\">\n                                </div>\n                            </div>\n                            <div class=\"carousel-indicators\" mbr-if=\"showIndicators\">\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsF02\" data-bs-slide-to=\"0\" class=\"active\" aria-current=\"true\" aria-label=\"Slide 1\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsF02\" data-bs-slide-to=\"1\" aria-label=\"Slide 2\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsF02\" data-bs-slide-to=\"2\" aria-label=\"Slide 3\" mbr-if=\"slidesAmount > 2\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsF02\" data-bs-slide-to=\"3\" aria-label=\"Slide 4\" mbr-if=\"slidesAmount > 3\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsF02\" data-bs-slide-to=\"4\" aria-label=\"Slide 5\" mbr-if=\"slidesAmount > 4\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsF02\" data-bs-slide-to=\"5\" aria-label=\"Slide 6\" mbr-if=\"slidesAmount > 5\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsF02\" data-bs-slide-to=\"6\" aria-label=\"Slide 7\" mbr-if=\"slidesAmount > 6\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsF02\" data-bs-slide-to=\"7\" aria-label=\"Slide 8\" mbr-if=\"slidesAmount > 7\">\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"buttons-container mt-3\" mbr-if=\"showControls\">\n                            <button class=\"prev-item\" type=\"button\" data-bs-target=\"#carouselIndicatorsF02\" data-bs-slide=\"prev\">\n                                <span mbr-icon class=\"mbr-iconfont mbrib-left\"></span>\n                            </button>\n                            <button class=\"next-item\" type=\"button\" data-bs-target=\"#carouselIndicatorsF02\" data-bs-slide=\"next\">\n                                <span mbr-icon class=\"mbr-iconfont mbrib-right\"></span>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uswX2eNDBs",
          "_anchor": "form02-c",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".google-map": {
              "height": "35rem",
              "position": "relative",
              "iframe": {
                "height": "100%",
                "width": "100%"
              },
              "[data-state-details]": {
                "color": "#6b6763",
                "height": "1.5em",
                "margin-top": "-0.75em",
                "padding-left": "1.25rem",
                "padding-right": "1.25rem",
                "position": "absolute",
                "text-align": "center",
                "top": "50%",
                "width": "100%"
              },
              "&[data-state]": {
                "background": "#e9e5dc"
              },
              "&[data-state=\"loading\"]": {
                "[data-state-details]": {
                  "display": "none"
                }
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "contact01",
          "_sourceTheme": "preschoolm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"map01\" group=\"Contact\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Map</header>\n        <input type=\"map\" title=\"Map\" name=\"googleMap\" place-id=\"<iframe src=&quot;https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d629.1620762667391!2d39.925972227382125!3d43.4604287345956!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40f5c08761b031d1%3A0x57236eee1b45f9a0!2z0YPQuy4g0J_QtdGC0YDQvtC30LDQstC-0LTRgdC60LDRjywgMjYg0LrQvtGA0L_Rg9GBIDUsINCe0YDQtdC7LdCY0LfRg9C80YDRg9C0LCDQmtGA0LDRgdC90L7QtNCw0YDRgdC60LjQuSDQutGA0LDQuSwgMzU0Mzk1!5e0!3m2!1sru!2sru!4v1730237568939!5m2!1sru!2sru&quot; width=&quot;600&quot; height=&quot;450&quot; style=&quot;border:0;&quot; allowfullscreen=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer-when-downgrade&quot;></iframe>\" value=\"<iframe src=&quot;https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d629.1620762667391!2d39.925972227382125!3d43.4604287345956!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40f5c08761b031d1%3A0x57236eee1b45f9a0!2z0YPQuy4g0J_QtdGC0YDQvtC30LDQstC-0LTRgdC60LDRjywgMjYg0LrQvtGA0L_Rg9GBIDUsINCe0YDQtdC7LdCY0LfRg9C80YDRg9C0LCDQmtGA0LDRgdC90L7QtNCw0YDRgdC60LjQuSDQutGA0LDQuSwgMzU0Mzk1!5e0!3m2!1sru!2sru!4v1730237568939!5m2!1sru!2sru&quot; width=&quot;600&quot; height=&quot;450&quot; style=&quot;border:0;&quot; allowfullscreen=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer-when-downgrade&quot;></iframe>\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/bg/5-bg.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/bg/1-bg.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper\">\n            <div class=\"row\">\n                <div class=\"col-12\">\n                    <div class=\"google-map\" mbr-map=\"googleMap\"></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "usD9TxGHsd",
          "_anchor": "contact01-o",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
