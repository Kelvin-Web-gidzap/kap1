            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".card": {
              "background": "transparent"
            },
            ".card-img": {
              "width": "32px",
              "height": "32px",
              "object-fit": "contain"
            },
            ".col.img": {
              "flex": "0 0 32px"
            },
            ".col.text": {
              "flex": "1 1 75%"
            },
            ".card-body": {
              "padding": "1px"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-title": {
              "color": "#1164e5"
            }
          },
          "_name": "features11",
          "_sourceTheme": "preschoolm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features11\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showImage\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Row</header>\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Column</header>\n        <input type=\"range\" inline title=\"Amount\" name=\"colAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"3\">\n        <header condition=\"showText\">Text</header>\n        <input type=\"range\" inline title=\"Width\" name=\"textWidth\" min=\"1\" max=\"5\" step=\"0.2\" value=\"5\" condition=\"showText\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/bg/2-bg.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/bg/1-bg.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper p-3 py-5 p-lg-5\">\n            <div class=\"row mb-4\" mbr-if=\"showTitle\">\n                <div class=\"col-12\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" data-app-placeholder=\"Type Text\"><b>В стоимость входят следующие занятия:</b></h2>\n                </div>\n            </div>\n            <div class=\"row {{contentAlign}}\">\n                <div class=\"card col-12 col-lg-4\">\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col img pt-1\" mbr-if=\"showImage\">\n                                <img class=\"card-img\" src=\"../_images/vector/stars/purple.svg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"col text\" mbr-if=\"showText\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-style=\"{'width': 'calc(' + textWidth + '* 20%)'}\">\n                                    Английский язык\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12 col-lg-4\" mbr-if=\"colAmount > 1\">\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col img pt-1\" mbr-if=\"showImage\">\n                                <img class=\"card-img\" src=\"../_images/vector/stars/red.svg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"col text\" mbr-if=\"showText\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-style=\"{'width': 'calc(' + textWidth + '* 20%)'}\">Музыкальные занятия\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12 col-lg-4\" mbr-if=\"colAmount > 1\">\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col img pt-1\" mbr-if=\"showImage\">\n                                <img class=\"card-img\" src=\"@PROJECT_PATH@/assets/images/orange.svg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"col text\" mbr-if=\"showText\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-style=\"{'width': 'calc(' + textWidth + '* 20%)'}\">Арт- студия\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12 col-lg-4\" mbr-if=\"colAmount > 1\">\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col img pt-1\" mbr-if=\"showImage\">\n                                <img class=\"card-img\" src=\"@PROJECT_PATH@/assets/images/cyan.svg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"col text\" mbr-if=\"showText\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-style=\"{'width': 'calc(' + textWidth + '* 20%)'}\">Пластилинография\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12 col-lg-4\" mbr-if=\"colAmount > 1\">\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col img pt-1\" mbr-if=\"showImage\">\n                                <img class=\"card-img\" src=\"@PROJECT_PATH@/assets/images/purple.svg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"col text\" mbr-if=\"showText\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-style=\"{'width': 'calc(' + textWidth + '* 20%)'}\">Развитие речи\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12 col-lg-4\" mbr-if=\"colAmount > 1\">\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col img pt-1\" mbr-if=\"showImage\">\n                                <img class=\"card-img\" src=\"@PROJECT_PATH@/assets/images/green.svg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"col text\" mbr-if=\"showText\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-style=\"{'width': 'calc(' + textWidth + '* 20%)'}\">Фитнес час\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12 col-lg-4\" mbr-if=\"colAmount > 1\">\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col img pt-1\" mbr-if=\"showImage\">\n                                <img class=\"card-img\" src=\"@PROJECT_PATH@/assets/images/orange.svg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"col text\" mbr-if=\"showText\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-style=\"{'width': 'calc(' + textWidth + '* 20%)'}\">Творческие и кулинарные мастерские\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12 col-lg-4\" mbr-if=\"colAmount > 1\">\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col img pt-1\" mbr-if=\"showImage\">\n                                <img class=\"card-img\" src=\"../_images/vector/stars/red.svg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"col text\" mbr-if=\"showText\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-style=\"{'width': 'calc(' + textWidth + '* 20%)'}\">Познавательно- экспериментальная деятельность\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12 col-lg-4\" mbr-if=\"colAmount > 2\">\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col img pt-1\" mbr-if=\"showImage\">\n                                <img class=\"card-img\" src=\"@PROJECT_PATH@/assets/images/cyan.svg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"col text\" mbr-if=\"showText\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-style=\"{'width': 'calc(' + textWidth + '* 20%)'}\">Уроки социальной жизни\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "usD65unt3u",
          "_anchor": "features11-n",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".wrapper": {
              "background-color": "if(@isTransparent, transparent, @rowColor)"
            },
            ".carousel": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center",
              "& .carousel-container": {
                "position": "relative",
                "& .carousel-inner": {
                  "border-radius": "50%",
                  "width": "300px",
                  "height": "300px",
                  "& .carousel-item, & img": {
                    "height": "100%"
                  },
                  "& img": {
                    "object-fit": "cover"
                  }
                },
                "& .carousel-indicators": {
                  "position": "static",
                  "padding": "20px 0",
                  "margin": "0",
                  "margin-bottom": "-60px",
                  "display": "flex",
                  "& button": {
                    "display": "block",
                    "width": "10px",
                    "height": "10px",
                    "flex": "0 0 10px",
                    "margin": "0 8px",
                    "padding": "0",
                    "border-radius": "50%",
                    "background-color": "lighten(@indicatorsColor, 40%)",
                    "opacity": "1",
                    "transition": "0.4s ease"
                  },
                  "& .active": {
                    "background-clip": "padding-box",
                    "background-color": "@indicatorsColor"
                  }
                }
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-title": {
              "text-align": "left"
            }
          },
          "_name": "slider04",
          "_sourceTheme": "preschoolm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider04\" group=\"Gallery & Slider\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Row</header>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"isTransparent\">\n        <input type=\"color\" title=\"Color\" name=\"rowColor\" value=\"#cc81f2\" condition=\"!isTransparent\">\n        <header>Slides</header>\n        <select title=\"Animation\" name=\"animationType\">\n            <option value selected>Slide</option>\n            <option value=\"carousel-fade\">Fade</option>\n        </select>\n        <input type=\"checkbox\" title=\"Indicators\" name=\"showIndicators\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"slidesAmount\" min=\"2\" max=\"8\" step=\"1\" value=\"8\">\n        <input type=\"range\" inline title=\"Interval\" name=\"slidesInterval\" min=\"1\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"color\" title=\"Indicators\" name=\"indicatorsColor\" value=\"#ff0066\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/bg/1-bg.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/bg/1-bg.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper p-3 py-5 p-lg-5\">\n            <div class=\"row\">\n                <div class=\"col-12 col-lg-5 pe-lg-5 d-flex align-items-center justify-content-center justify-content-lg-end justify-content-xxl-center\">\n                    <div id=\"carouselIndicatorsS04\" class=\"carousel slide {{animationType}}\" data-bs-ride=\"carousel\" data-bs-interval=\"{{slidesInterval*1000}}\">\n                        <div class=\"carousel-container\">\n                            <div class=\"carousel-inner\">\n                                <div class=\"carousel-item active\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/img-20240404-161414-600x452.jpg\" class=\"d-block w-100\" alt=\"Группа детей Капитошка\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/img-20241015-wa0104-600x450.jpg\" class=\"d-block w-100\" alt=\"Дети в детском саду Капитошка\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/trashed-1731476726-img-20240617-154932-600x452.jpg\" class=\"d-block w-100\" alt=\"Дети учатся в Капитошке\" mbr-if=\"slidesAmount > 2\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/cbsd4575-600x800.jpg\" class=\"d-block w-100\" alt=\"Капитошка детский сад\" mbr-if=\"slidesAmount > 3\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/img-20241015-wa0095-600x337.jpg\" class=\"d-block w-100\" alt=\"Капитошка в Адлере\" mbr-if=\"slidesAmount > 4\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/img-20240216-wa0008-600x450.jpg\" class=\"d-block w-100\" alt=\"познаем мир в Капитошке\" mbr-if=\"slidesAmount > 5\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/img-20230721-155919-600x452.jpg\" class=\"d-block w-100\" alt=\"Эксперементы в Капитошке\" mbr-if=\"slidesAmount > 6\">\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/img-20241015-wa0100-600x337.jpg\" class=\"d-block w-100\" alt=\"Школа в Капитошке\" mbr-if=\"slidesAmount > 7\">\n                                </div>\n                            </div>\n                            <div class=\"carousel-indicators\" mbr-if=\"showIndicators\">\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsS04\" data-bs-slide-to=\"0\" class=\"active\" aria-current=\"true\" aria-label=\"Slide 1\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsS04\" data-bs-slide-to=\"1\" aria-label=\"Slide 2\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsS04\" data-bs-slide-to=\"2\" aria-label=\"Slide 3\" mbr-if=\"slidesAmount > 2\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsS04\" data-bs-slide-to=\"3\" aria-label=\"Slide 4\" mbr-if=\"slidesAmount > 3\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsS04\" data-bs-slide-to=\"4\" aria-label=\"Slide 5\" mbr-if=\"slidesAmount > 4\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsS04\" data-bs-slide-to=\"5\" aria-label=\"Slide 6\" mbr-if=\"slidesAmount > 5\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsS04\" data-bs-slide-to=\"6\" aria-label=\"Slide 7\" mbr-if=\"slidesAmount > 6\">\n                                </button>\n                                <button type=\"button\" data-bs-target=\"#carouselIndicatorsS04\" data-bs-slide-to=\"7\" aria-label=\"Slide 8\" mbr-if=\"slidesAmount > 7\">\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-lg-7 d-flex flex-column justify-content-center p-3 p-lg-5\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style w-100 mb-4 mb-lg-3 mt-3\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" data-app-placeholder=\"Type Text\" mbr-if=\"showTitle\"><b>Приглашаем в гости</b></h2>\n                    <p class=\"mbr-text mbr-fonts-style w-100 mb-2 mb-lg-3\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\" mbr-if=\"showText\">Наш развивающий центр осуществляет присмотр и уход за детьми, учитывая индивидуальные особенности каждого ребенка. Мы заботимся о Ваших детках, их безопасности и всестороннем развитии.<br><br>Приходите в гости на экскурсию по нашему развивающему центру.<br></p>\n                    <div class=\"mbr-section-btn w-100\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"><a class=\"btn btn-white justify-content-center\" data-app-placeholder=\"Введите Текст\">\n                            ЗАПИСАТЬСЯ НА ЭКСКУРСИЮ</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uswQYnU6Gz",
          "_anchor": "slider04-a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".wrapper": {
              "display": "flex",
              "flex-wrap": "wrap",
              "@media (min-width: 992px)": {
                "& .left-col": {
                  "flex": "1 0 50%",
                  "padding-right": "12px"
                },
                "& .right-col": {
                  "flex": "1 0 50%",
                  "padding-left": "12px"
                }
              }
            },
            ".card": {
              "padding": "0",
              "background-color": "#fff",
              "overflow": "hidden",
              "& when (@hasShadow)": {
                "box-shadow": "0px 10px 20px 0px rgba(29, 29, 27, 0.2)"
              }
            },
            ".card-img": {
              "width": "100%",
              "height": "100%",
